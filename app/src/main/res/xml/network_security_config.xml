<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http:// is allowed because most home Navidrome servers are reached by LAN IP
     (e.g. http://192.168.1.10:4533). Passwords are never sent: Subsonic token login sends
     only md5(password + random salt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Certificates you installed on the phone (for a home CA / reverse proxy) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
